PORT=3000
TRANSIT_PROVIDER=gpsbahia
REALTIME_REFRESH_MS=5000
REALTIME_IDLE_TTL_MS=120000
REALTIME_MAX_ACTIVE_LINES=8
REALTIME_MAX_CONCURRENT_REQUESTS=2
LIVE_AFTER_MS=30000
STALE_AFTER_MS=120000
VERY_STALE_AFTER_MS=120000
VEHICLE_VISIBLE_MAX_AGE_MS=120000
PUBLIC_API_URL=http://localhost:3000
# Comma-separated browser origins for a separately deployed frontend. Same-origin
# requests need no CORS; localhost/127.0.0.1 are accepted for development.
CORS_ALLOWED_ORIGINS=
# Comma-separated proxy IPs/CIDRs. Leave empty for direct connections.
TRUSTED_PROXY_IPS=
DEBUG_ENDPOINTS=false
STATIC_CACHE_DIR=data/cache

# Optional: override GPSBahia public website (no secrets; session cookie is obtained at runtime).
GPSBAHIA_BASE_URL=https://www.gpsbahia.com.ar/

# Public Firebase client database URL used by ColectivosYa / gpsbus-web (Apache-2.0).
# This is NOT an Admin SDK credential and MUST NOT be treated as a secret.
GPSBUS_DATABASE_URL=https://gps-bus-7811f-default-rtdb.firebaseio.com
GPSBUS_CITY_KEY=bhi
