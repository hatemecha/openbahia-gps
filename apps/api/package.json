{
  "name": "@openbahia/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prestart": "pnpm -w run build:packages && pnpm build",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "LIVE_GPS=1 vitest run src/live.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@openbahia/provider-gpsbahia": "workspace:*",
    "@openbahia/provider-gpsbus": "workspace:*",
    "@openbahia/provider-mock": "workspace:*",
    "@openbahia/shared": "workspace:*",
    "@openbahia/transit-core": "workspace:*",
    "dotenv": "^17.2.1",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.4",
    "playwright": "^1.55.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.2.4"
  }
}
